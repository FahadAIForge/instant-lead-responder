    {
      "parameters": {
        "jsCode": "const lead = $('Normalize Lead').first().json;\nconst content = $json.choices[0].message.content;\nconst ai = JSON.parse(content);\nreturn [{ json: {\n  name: lead.name,\n  email: lead.email,\n  service: lead.service,\n  message: lead.message,\n  score: ai.score,\n  category: ai.category,\n  reason: ai.reason,\n  reply: ai.reply\n} }];"
      },

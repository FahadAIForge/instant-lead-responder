ization, Value = Bearer YOUR_OPENAI_API_KEY.","parameters":{"authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","jsonBody":"{\n  \"model\": \"gpt-4o-mini\",\n  \"temperature\": 0.3,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a lead qualification assistant for an AI automation agency run by Fahad Khan (services: AI agents & chatbots, n8n workflow automation, Python development). Score the lead 0-100 on buying intent and fit. Category: hot (70+), warm (40-69), cold (below 40). Draft a short, friendly, professional reply (max 80 words) that acknowledges their exact need, states one relevant benefit, and says a human will confirm a call shortly. Never invent prices, timelines, or guarantees. Return ONLY valid JSON: { \\\"score\\\": number, \\\"category\\\": \\\"hot|warm|cold\\\", \\\"reason\\\": string, \\\"reply\\\": string }.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Name: {{ $json.name }}\\nEmail: {{ $json.email }}\\nService interested in: {{ $json.service }}\\nMessage: {{ $json.message }}\"\n    }\n  ]\n}","method":"POST","options":{"response":{"response":{"responseFormat":"json"}},"timeout":30000},"sendBody":true,"specifyBody":"json","url":"https://api.openai.com/v1/chat/completions"},"position":[440,300],"type":"n8n-nodes-base.httpRequest","typeVersion":4.2},{"id":"node-parse","name":"Parse AI Result","parameters":{"jsCode":"const lead = $('Normalize Lead').first().json;\nconst content = $json.choices[0].message.content;\nconst ai = JSON.parse(content);\nreturn [{ json: {\n  name: lead.name,\n  email: lead.email,\n  service: lead.service,\n  message: lead.message,\n  score: ai.score,\n  category: ai.category,\n  reason: ai.reason,\n  reply: ai.reply\n} }];"},"position":[660,300],"type":"n8n-nodes-base.code","typeVersion":2},{"id":"node-if","name":"Is Hot Lead?","parameters":{"conditions":{"combinator":"and","conditions":[{"id":"cond-hot","leftValue":"={{ $json.score }}","operator":{"operation":"gte","type":"number"},"rightValue":70}],"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2}},"looseTypeValidation":true},"position":[880,300],"type":"n8n-nodes-base.if","typeVersion":2.2},{"id":"node-mark-hot","name":"Mark HOT","parameters":{"assignments":{"assignments":[{"id":"s-status-hot","name":"status","type":"string","value":"Hot — replied"}]},"options":{}},"position":[1100,180],"type":"n8n-nodes-base.set","typeVersion":3.4},{"credentials":{"gmailOAuth2":{"id":null,"name":"Gmail account"}},"id":"node-gmail-hot","name":"Reply to Hot Lead","parameters":{"emailType":"text","message":"={{ $json.reply }}\n\n— Fahad Khan, AI Automation Specialist","operation":"send","options":{},"resource":"message","sendTo":"={{ $json.email }}","subject":"=Re: Your {{ $json.service }} inquiry — quick reply"},"position":[1320,180],"type":"n8n-nodes-base.gmail","typeVersion":2.1},{"credentials":{"googleSheetsOAuth2":{"id":null,"name":"Google Sheets account"}},"id":"node-sheet-hot","name":"Log Hot Lead","parameters":{"columns":{"attemptToConvertTypes":false,"convertFields":false,"mappingMode":"defineBelow","matchingColumns":[],"schema":[{"canBeUsedToMatch":true,"defaultMatch":false,"display":true,"displayName":"Timestamp","id":"Timestamp","required":false,"type":"string"},{"canBeUsedToMatch":true,"defaultMatch":false,"display":true,"displayName":"Name","id":"Name","required":false,"type":"string"},{"canBeUsedToMatch":true,"defaultMatch":false,"display":true,"displayName":"Email","id":"Email","required":false,"type":"string"},{"canBeUsedToMatch":true,"defaultMatch":false,"display":true,"displayName":"Service","id":"Service","required":false,"type":"string"},{"canBeUsedToMatch":true,"defaultMatch":false,"display":true,"displayName":"Message","id":"Message","required":false,"type":"string"},{"canBeUsedToMatch":true,"defaultMatch":false,"display":true,"displayName":"Score","id":"Sco